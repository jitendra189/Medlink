# Database (use DATABASE_URL in hosted environments such as Railway,
# or use the four discrete variables for local Docker/Postgres)
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medlink
DATABASE_USER=medlink_user
DATABASE_PASSWORD=medlink_pass
# Keep synchronize disabled by default; use migrations for schema changes.
DB_SYNCHRONIZE=false

# API
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Google Maps (frontend)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
